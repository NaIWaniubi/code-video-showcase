{
  "$comment": "cvs taste 规则目录 v2（G3-6 单一真值：本表的 assert 字段是判决阈值的唯一来源，scripts/taste.mjs 的 EVALS 只消费不硬编码；缺失/非法 assert → taste 启动即错 E_TASTE_ASSERT，不许静默回退）。severity: error=硬闸(永远拦) · warning=计入扣分并 --strict 拦 · advisory=永不拦只列示。weight 为 warning 扣分权重。from 记录思想来源（hallmark slop-test 门号 / impeccable 规则 id / opus-video-prompts 路线）。input: spec=可判 · frames=帧级，依赖 G7 像素通路，当前在 taste 中显式 skip 并计数（诚实报告「帧级未实装 N 条」，不进判决不假绿）。waivable: 豁免只作用非 error 级；豁免生命周期见 taste.mjs G3-7：reason 必填非空；rule 必须在目录；date=豁免有效期止（YYYY-MM-DD，早于 --today 即过期并计入 blocking）。",
  "version": 2,
  "rules": [
    { "id": "placeholder-copy", "title": "文案残留占位词", "from": "impeccable:placeholder / opuscar §4", "severity": "error", "input": "spec", "waivable": true,
      "assert": { "regex": "lorem|tbd|todo|\\{\\{|待填|示例|acme|jane doe|john doe|nexus(?! lab)", "fields": ["meta.brand", "meta.title", "meta.cta", "copy", "card.first", "card.keyword", "style.copy"] } },
    { "id": "theme-known", "title": "主题 id 必须在主题表内", "from": "CVS 单一真值", "severity": "error", "input": "spec", "waivable": false,
      "assert": { "in": "THEME_IDS", "nullMeans": "default-theme" } },
    { "id": "contrast-body", "title": "正文/墨色对底 APCA Lc ≥ 60（口径=模板层 auditApca 单一真值；含 look.accentOverride 合成后主题）", "from": "hallmark#40", "severity": "error", "input": "spec", "waivable": true,
      "assert": { "metric": "auditApca row ink/bg", "source": "templates/color.js", "overrideAware": true } },
    { "id": "contrast-large", "title": "muted/accent 对底不达 auditApca 口径（muted≥45 · accent≥30；含 accentOverride）", "from": "hallmark#41 / CVS 自家口径", "severity": "warning", "weight": 10, "input": "spec", "waivable": true,
      "assert": { "metric": "auditApca rows muted/bg + accent/bg", "source": "templates/color.js", "overrideAware": true } },
    { "id": "black-on-black", "title": "强调色与焦点面不得同亮同彩（accentSoft 按 accentOverride 派生后判）", "from": "hallmark#41", "severity": "warning", "weight": 8, "input": "spec", "waivable": true,
      "assert": { "pair": ["accentSoft", "surface"], "maxLightDist": 5, "maxChromaDist": 0.05, "overrideAware": true } },
    { "id": "neutral-chroma", "title": "中性色不得零彩度（禁用纯灰）", "from": "hallmark#22", "severity": "warning", "weight": 6, "input": "spec", "waivable": true,
      "assert": { "metric": "oklchC(muted)", "min": 0.005 } },
    { "id": "override-silent", "title": "accentOverride 与主题 accent 相同 = 空转", "from": "CVS F3 教训", "severity": "warning", "weight": 6, "input": "spec", "waivable": true,
      "assert": { "eq": ["look.accentOverride.accent", "theme.accent(未覆盖原值)"] } },
    { "id": "style-duplicate-page", "title": "同一画风页不得在多轮复用", "from": "CVS style-pages 单一真值", "severity": "warning", "weight": 10, "input": "spec", "waivable": true,
      "assert": { "maxPerValue": 1, "of": "rounds[].style.page(path)" } },
    { "id": "transition-variety", "title": "≥3 轮不得全片硬切", "from": "motion-doctrine seam / hyperframes 契约", "severity": "warning", "weight": 8, "input": "spec", "waivable": true,
      "assert": { "whenRoundsGte": 3, "of": "render.transition", "offMeans": "null|false|''|none|cut=硬切（真值 templates/transitions.mjs isTransitionOff）" } },
    { "id": "beat-grid", "title": "轮长/卡长必须落在 BPM 拍网格上（首尾段放宽；段身份按名字非秒数相等）", "from": "CVS 卡点教义 / opusprompts 实测 beat grid", "severity": "warning", "weight": 10, "input": "spec", "waivable": true,
      "assert": { "expr": "frac(sec*bpm/60) 距最近整数拍；round/card ≤ tolerance，opening/ending ≤ edgeTolerance", "tolerance": 0.05, "edgeTolerance": 0.25, "edgeSegments": ["opening", "ending"] } },
    { "id": "flash-overload", "title": "快闪段总时长 ≤ 全片 15%", "from": "SKILL §3 结构公式", "severity": "warning", "weight": 8, "input": "spec", "waivable": true,
      "assert": { "expr": "flash.count*flash.each / duration", "max": 0.15 } },
    { "id": "duration-band", "title": "总时长在产品带内（min/max 以本条 assert 为准）", "from": "CVS 定位（30–90s，容差带）", "severity": "warning", "weight": 6, "input": "spec", "waivable": true,
      "assert": { "metric": "format.duration", "min": 20, "max": 95 } },
    { "id": "copy-density", "title": "每轮应有副题（信息密度非空壳）", "from": "taste check:section-fill", "severity": "advisory", "input": "spec", "waivable": true,
      "assert": { "allNonEmpty": "rounds[].style.copy.subtitle" } },
    { "id": "fabricated-metric", "title": "文案数字声明（≥95%/10×/万级）需来源", "from": "hallmark#46", "severity": "advisory", "input": "spec", "waivable": true,
      "assert": { "regex": "(9[5-9]|100)\\s*%|\\b10\\s*[×xX倍]|\\d+\\s*万\\+?(次|人|用户)", "exemptIfMatches": "实测|复现|eval|bench|repro" } },

    { "id": "frame-accent-token-dist", "title": "帧主色距主题 token（帧级·未实装，input=frames 显式 skip）", "from": "ROADMAP-OVERTAKE S1-1 帧级条", "severity": "warning", "weight": 6, "input": "frames", "waivable": true,
      "assert": { "metric": "dominantHueDistToThemeTokens", "max": 0.12, "requires": "G7 像素通路" } },
    { "id": "frame-dark-glow", "title": "暗底光晕溢出（帧级·未实装）", "from": "ROADMAP-OVERTAKE S1-1 帧级条", "severity": "warning", "weight": 6, "input": "frames", "waivable": true,
      "assert": { "metric": "glowBloomOnDarkBg", "max": 0.2, "requires": "G7 像素通路" } },
    { "id": "frame-blank-energy", "title": "空白帧能量（帧级·未实装；口径参考 DECISIONS 空帧 <8KB 判据）", "from": "docs/DECISIONS.md 空帧判据", "severity": "warning", "weight": 10, "input": "frames", "waivable": true,
      "assert": { "metric": "pngBytesPerFrame", "min": 8192, "requires": "G7 像素通路" } },
    { "id": "frame-text-coverage", "title": "字占比（帧级·未实装）", "from": "ROADMAP-OVERTAKE S1-1 帧级条", "severity": "warning", "weight": 6, "input": "frames", "waivable": true,
      "assert": { "metric": "textPixelSharePerFrame", "min": 0.02, "max": 0.35, "requires": "G7 像素通路" } },
    { "id": "frame-flash-burst", "title": "爆帧（帧级·未实装）", "from": "ROADMAP-OVERTAKE S1-1 帧级条", "severity": "warning", "weight": 8, "input": "frames", "waivable": true,
      "assert": { "metric": "adjacentFrameLumaSpike", "max": 0.6, "requires": "G7 像素通路" } },
    { "id": "frame-fx-continuity", "title": "效果连续 N 段（帧级·未实装）", "from": "ROADMAP-OVERTAKE S1-1 帧级条", "severity": "warning", "weight": 5, "input": "frames", "waivable": true,
      "assert": { "metric": "sameFxConsecutiveSegments", "max": 3, "requires": "G7 像素通路" } }
  ]
}
